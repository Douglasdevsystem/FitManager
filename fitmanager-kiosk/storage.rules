// ⚠️ NÃO faça `firebase deploy --only storage` com este arquivo sozinho.
//
// Mesmo aviso do firestore.rules: este projeto Firebase já tem outro sistema
// publicado com suas próprias Storage Rules. Copie o bloco abaixo para
// dentro do storage.rules já existente do projeto appfood-e25bb — todo
// caminho já está sob o prefixo "fitmanager/", então não deveria colidir
// com nada que já exista.
//
// rules_version = '2';
// service firebase.storage {
//   match /b/{bucket}/o {
//
//     ...regras existentes do appfood aqui, sem mexer...
//
//     <<< COLE DAQUI PARA BAIXO >>>

    match /fitmanager/fotos-alunos/{alunoId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    match /fitmanager/checkins-fotos/{checkinId}.jpg {
      // Gravado pelo kiosk via Admin SDK — client não precisa escrever aqui.
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Fotos do Perfil do aluno (galeria estilo Tinder). Só o próprio aluno
    // envia/remove; limite de 5 MB e apenas imagens. Usa uma consulta ao
    // Firestore (cross-service rules) — o Console pede para autorizar isso
    // na primeira vez que as regras forem publicadas.
    match /fitmanager/perfis-alunos/{alunoId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && firestore.get(/databases/(default)/documents/fitmanager_usuarios/$(request.auth.uid)).data.alunoId == alunoId
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && firestore.get(/databases/(default)/documents/fitmanager_usuarios/$(request.auth.uid)).data.alunoId == alunoId;
    }

    match /fitmanager/documentos-academia/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

//     <<< COLE ATÉ AQUI >>>
//   }
// }
