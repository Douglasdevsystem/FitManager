rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Outros sistemas deste projeto (appfood) ────────────────────────────
    // Mantém o comportamento anterior (aberto) para tudo que NÃO está na
    // pasta fitmanager/. ⚠️ Isso deixa os arquivos do appfood abertos para
    // qualquer pessoa — o appfood precisa de regras próprias.
    match /{pasta}/{resto=**} {
      allow read, write: if pasta != 'fitmanager';
    }

    // ─── FitManager ─────────────────────────────────────────────────────────

    // Equipe (admin/personal) ativa do FitManager — consulta o Firestore.
    function fmEquipeStorage() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/fitmanager_usuarios/$(request.auth.uid)).data.perfil in ["administrador", "personal"];
    }

    // {alunoId}.jpg — o curinga do Storage precisa ser o nome inteiro do arquivo.
    // A foto é enviada no cadastro ANTES de o aluno existir no Firestore, por
    // isso a checagem é "é da equipe", não "é da academia do aluno".
    match /fitmanager/fotos-alunos/{arquivo} {
      allow read: if request.auth != null;
      allow create, update: if fmEquipeStorage()
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if fmEquipeStorage();
    }

    match /fitmanager/checkins-fotos/{arquivo} {
      // Gravado pelo kiosk via Admin SDK — client não precisa escrever aqui.
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Fotos do Perfil do aluno (galeria estilo Tinder). Só o próprio aluno
    // envia/remove; limite de 5 MB e apenas imagens. Usa uma consulta ao
    // Firestore (cross-service rules) — o Console pede para autorizar isso
    // na primeira vez que as regras forem publicadas.
    match /fitmanager/perfis-alunos/{alunoId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && firestore.get(/databases/(default)/documents/fitmanager_usuarios/$(request.auth.uid)).data.alunoId == alunoId
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && firestore.get(/databases/(default)/documents/fitmanager_usuarios/$(request.auth.uid)).data.alunoId == alunoId;
    }

    match /fitmanager/documentos-academia/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

  }
}
